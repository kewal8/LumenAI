# Copy to .env.local and fill in. Never commit .env.local.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=
# Public address of the site, used in invite links printed by `npm run invite`.
APP_URL=http://localhost:3000
# Optional: send password-reset emails through Resend. Without these the
# reset link is written to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: address that receives each new demo request (needs the two above).
DEMO_NOTIFY_EMAIL=
